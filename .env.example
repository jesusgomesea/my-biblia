# Gera os planos de estudo. Crie a sua em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: força um modelo específico do Gemini.
# Sem isto, o app percorre uma lista de modelos até um responder.
# MODELO_GEMINI=

# --- Auth.js (login com Google) ---
# Segredo para assinar o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Credenciais OAuth 2.0 do Google Cloud Console. Adicione como URIs autorizadas:
#   http://localhost:3000/api/auth/callback/google
#   https://my-biblia.netlify.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
