# Gera os planos de estudo. Crie a sua em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: força um modelo específico do Gemini.
# Sem isto, o app percorre uma lista de modelos até um responder.
# MODELO_GEMINI=

# --- Netlify Identity ---
# Nao ha variavel de ambiente: o Identity e ligado no painel do Netlify
# (Site configuration -> Identity) e o endpoint vem do proprio runtime.
# Localmente exige `netlify dev`; com `next dev` puro o login nao sobe.
